{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@sathus-platform/ui": ["../../packages/ui/src/index.ts"],
      "@sathus-platform/types": ["../../packages/types/src/index.ts"],
      "@sathus-platform/config": ["../../packages/config/src/index.ts"],
      "@sathus-platform/utils": ["../../packages/utils/src/index.ts"],
      "@sathus-platform/hooks": ["../../packages/hooks/src/index.ts"],
      "@sathus-platform/icons": ["../../packages/icons/src/index.ts"],
      "@sathus-platform/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@sathus-platform/auth": ["../../packages/auth/src/index.ts"],
      "@sathus-platform/api-client": ["../../packages/api-client/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "vitest.config.ts"]
}
